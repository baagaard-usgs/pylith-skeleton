        "html-webpack-plugin": "latest",
        "relay-compiler": "latest",
        "webpack": "latest",
        "webpack-cli": "latest",
        "webpack-dev-server": "latest"
    },
    "dependencies": {
        "graphql": "latest",
        "lodash": "latest",
        "react": "<19",
        "react-dom": "<19",
        "react-relay": "latest",
        "react-router": "latest",
        "react-router-dom": "latest",
        "regenerator-runtime": "latest",
        "relay-runtime": "latest"
    }
