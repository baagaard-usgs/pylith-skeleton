# pylith Python package configuration


# the installed package name
pylith.pkg.stem := pylith
# sources live in packages/pylith/, not the default pkg/pylith/
pylith.pkg.root := packages/pylith/
# pyre configuration files live in etc/; deployed to {prefix}/share/pylith/
pylith.pkg.defaults := etc/
# meta.py is a static file, not an autogenerated template
pylith.pkg.meta :=
# driver scripts installed into {prefix}/bin/
pylith.pkg.drivers := pylith


# end of file
